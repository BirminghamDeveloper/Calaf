rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /privateUploads/{uid}/{photoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
        && photoId.matches('photo-[0-5][.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Public/approved photographs require a separately secured moderation pipeline.
    match /{path=**} { allow read, write: if false; }
  }
}
