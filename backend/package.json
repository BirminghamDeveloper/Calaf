{
  "name": "calaf-backend",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "test": "node --test test/domain.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "check": "node --check src/index.js && node --check src/service.js",
    "emulators": "firebase emulators:start --project demo-calaf --config ../firebase.json",
    "test:emulator": "firebase emulators:exec --project demo-calaf-tests --config ../firebase.json --only firestore,auth,storage \"npm run test:integration\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": { "firebase-tools": "15.34.1", "@firebase/rules-unit-testing": "6.0.0", "firebase": "13.1.0" }
}
